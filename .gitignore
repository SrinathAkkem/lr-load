# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
# packaged Hostinger / Node host bundle (generated by `npm run build:standalone`)
/dist

# misc
.DS_Store
*.pem

# editor / IDE
.idea/
.vscode/*
!.vscode/settings.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime uploads (LR photos, signatures, logos, stamps) — keep dir, drop files
/public/uploads/**/*
!/public/uploads/
!/public/uploads/.gitkeep
!/public/uploads/photos/
!/public/uploads/signatures/
!/public/uploads/logos/
!/public/uploads/stamps/
