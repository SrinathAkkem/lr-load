# ────────────────────────────────────────────────────────────────────────────
#  Rono LR — production environment
# ────────────────────────────────────────────────────────────────────────────
# Copy to `.env.production` (LOCAL build) or paste these into the host's UI.
# Never commit a filled-in copy of this file.
#
#  Vercel  (recommended free path)  → paste into Project Settings → Env Vars
#  Hostinger Node.js App            → paste into hPanel → Setup Node.js App
#  Hostinger VPS / EC2              → write into the .env file on the server

# ── Database (REQUIRED) ──────────────────────────────────────────────────────
# Format:  mysql://USER:PASSWORD@HOST:3306/DBNAME[?options]
#
#   DBNAME  = u767592127_LRLoad           (already created on Hostinger)
#   USER    = u767592127_rayudugroup      (already created on Hostinger)
#   PASS    = (in hPanel → Databases, click the "eye" icon to reveal)
#   HOST    = where the app is running:
#             • Vercel / external host → the "Remote MySQL" hostname Hostinger
#                                         shows after you whitelist `%`
#                                         (looks like srvNNN.hstgr.io)
#             • Hostinger Node app on the same plan → "localhost"
#             ⚠  Never use auth-db1387.hstgr.io — that's only phpMyAdmin's UI.
#
# Tip for Vercel: append `?connection_limit=5` so concurrent serverless
# functions don't exhaust the shared MySQL connection cap.
DATABASE_URL="mysql://u767592127_rayudugroup:REPLACE_WITH_DB_PASSWORD@REPLACE_WITH_REMOTE_HOST:3306/u767592127_LRLoad?connection_limit=5"

# ── Public URL (REQUIRED) ────────────────────────────────────────────────────
# Used in QR landing links, PDF footers, "view on web" deep links, etc.
#   Vercel auto-generates one like https://<project>.vercel.app the first time.
#   Update this AFTER the first deploy and redeploy.
NEXT_PUBLIC_APP_URL="https://lightblue-partridge-337209.hostingersite.com"

# ── Auth signing key (REQUIRED) ──────────────────────────────────────────────
# Generate once with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Sessions and bcrypt-protected admin passwords use this. Rotate => invalidates
# every signed-in user. KEEP IT SECRET.
AUTH_SECRET="REPLACE_WITH_A_LONG_RANDOM_STRING"

# ── Storage (auto-detected) ──────────────────────────────────────────────────
# • Vercel: enable "Vercel Blob" in Project → Storage. Vercel auto-injects
#           BLOB_READ_WRITE_TOKEN; the storage adapter then switches to Blob.
# • Hostinger / VPS: leave both unset; uploads go to `public/uploads`.
# • Force a specific driver:
#     STORAGE_DRIVER=vercel-blob | disk
# BLOB_READ_WRITE_TOKEN=""           # set automatically by Vercel
# STORAGE_DRIVER=""

# Where uploaded files are written when STORAGE_DRIVER=disk. Default is
# `<app>/public/uploads`. On Hostinger / VPS, point this at a folder OUTSIDE
# the deployable bundle (e.g. /home/u767592127/persistent/uploads) and
# symlink `public/uploads -> $UPLOAD_DIR` to keep uploads across redeploys.
# UPLOAD_DIR=""

# ── Optional ────────────────────────────────────────────────────────────────
NODE_ENV="production"
# Port. Vercel and Hostinger Node.js App inject $PORT automatically; only set
# this on a VPS / EC2 if you want to bind a non-default port.
# PORT="3000"
