# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LR Load Backend - Environment Variables (PRODUCTION)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━ Database ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_URL="mysql://user:password@host:3306/database"

# ━━━ Authentication ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
AUTH_SECRET="your-super-secret-jwt-key-min-32-chars"

# ━━━ Environment ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
APP_ENV="production"
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://ronolr.com"

# ━━━ SMS Service (SMSLogin.co) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
OTP_SMS_ENABLED="true"
SMSLOGIN_USERNAME="Rayuduemp"
SMSLOGIN_API_KEY=""
SMSLOGIN_SENDER_ID="RONOLR"
SMSLOGIN_DLT_ENTITY_ID="1701172163467882881"
SMSLOGIN_DLT_TELEMARKETER_ID="1702157311403317201"
SMSLOGIN_DLT_TEMPLATE_ID="1777178541803547463"
SMSLOGIN_OTP_MESSAGE="{code} is your OTP to access RonoLR. It is valid for 2 minutes. Do not share this code with anyone,"

# ━━━ Twilio (optional fallback if SMSLogin not used) ━━━━━━━
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# ━━━ File Storage (CloudFlare R2 or AWS S3) ━━━━━━━━━━━━━━━
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="ronohub-lr"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ━━━ Payment Gateway (Razorpay) ━━━━━━━━━━━━━━━━━━━━━━━━━━
RAZORPAY_KEY_ID="your-razorpay-key"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ━━━ Superadmin ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SUPERADMIN_MOBILE="9999999999"
SUPERADMIN_PASSWORD="secure-password-here"

# ━━━ Error Tracking (Optional - Sentry) ━━━━━━━━━━━━━━━━━━━
# SENTRY_DSN="https://your-sentry-dsn"

# ━━━ Contact form email (/contact page) ━━━━━━━━━━━━━━━━━━━
CONTACT_EMAIL_ENABLED="true"
CONTACT_NOTIFY_EMAIL="rayudugroup01@gmail.com"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="rayudugroup01@gmail.com"
SMTP_PASS=""
SMTP_FROM="Rono Contact <rayudugroup01@gmail.com>"
