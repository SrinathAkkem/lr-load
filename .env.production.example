# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
# LR Load Backend - Environment Variables (PRODUCTION)
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# ━━━ Database ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
DATABASE_URL="mysql://user:password@host:3306/database"

# ━━━ Authentication ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="7d"

# ━━━ SMS Service (SMSLogin.co) ━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SMSLOGIN_USERNAME="Rayuduemp"
SMSLOGIN_PASSWORD="Rayuduemp753"
SMSLOGIN_SENDER_ID="RONOHB"
SMSLOGIN_DLT_ENTITY_ID="your-dlt-entity-id"
SMSLOGIN_DLT_TEMPLATE_ID="your-dlt-template-id"

# ━━━ File Storage (CloudFlare R2 or AWS S3) ━━━━━━━━━━━━━━━
R2_ACCOUNT_ID="your-account-id"
R2_ACCESS_KEY_ID="your-access-key"
R2_SECRET_ACCESS_KEY="your-secret-key"
R2_BUCKET_NAME="ronohub-lr"
R2_PUBLIC_URL="https://your-bucket.r2.dev"

# ━━━ Payment Gateway (Razorpay) ━━━━━━━━━━━━━━━━━━━━━━━━━━
RAZORPAY_KEY_ID="your-razorpay-key"
RAZORPAY_KEY_SECRET="your-razorpay-secret"

# ━━━ Superadmin ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
SUPERADMIN_MOBILE="9999999999"
SUPERADMIN_PASSWORD="secure-password-here"

# ━━━ Environment ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://lr.ronohub.com"

# ━━━ Error Tracking (Optional - Sentry) ━━━━━━━━━━━━━━━━━━━
# SENTRY_DSN="https://your-sentry-dsn"
