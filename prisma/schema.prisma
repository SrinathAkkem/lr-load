// Rono LR — production database schema (MySQL)
// Compatible with: Hostinger MySQL, AWS RDS MySQL, local Docker MySQL 8.

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  company_admin
  executive
}

enum UserStatus {
  active
  inactive
  invited
}

enum CompanyStatus {
  active
  suspended
}

enum LRStatus {
  pending
  approved
  rejected
  in_transit
  delivered
}

enum PaymentMode {
  TO_PAY     @map("To Pay")
  PAID       @map("Paid")
  TO_BE_BILLED @map("To Be Billed")
}

model Company {
  id            String        @id @default(cuid())
  name          String        @db.VarChar(255)
  logoUrl       String?       @db.VarChar(500)
  address       String        @db.Text
  gstNumber     String        @db.VarChar(32)
  stampUrl      String?       @db.VarChar(500)
  lrCode        String        @unique @db.VarChar(16)
  contactPhone  String        @db.VarChar(32)
  maxBranches   Int           @default(5)
  maxExecutives Int           @default(50)
  maxLrPerMonth Int           @default(200)
  status        CompanyStatus @default(active)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  branches      Branch[]
  users         User[]
  lrRequests    LRRequest[]
  lrSerial      LRSerial?

  @@index([status])
}

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String   @db.VarChar(255)
  city      String   @db.VarChar(120)
  state     String   @db.VarChar(120)
  createdAt DateTime @default(now())

  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  users      User[]
  lrRequests LRRequest[]

  @@index([companyId])
}

model User {
  id        String     @id @default(cuid())
  mobile    String     @unique @db.VarChar(15)
  email     String?    @unique @db.VarChar(255)
  password  String?    @db.VarChar(255) // only super_admin uses this; bcrypt hash
  role      UserRole
  companyId String?
  branchId  String?
  name      String     @db.VarChar(255)
  status    UserStatus @default(active)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  executiveLrs   LRRequest[]     @relation("ExecutiveLRs")
  notifications  Notification[]
  savedAddresses SavedAddress[]

  @@index([companyId, role])
  @@index([branchId])
  @@index([role])
}

model LRRequest {
  id                  String      @id @default(cuid())
  lrNumber            String?     @db.VarChar(64)
  trackingId          String      @unique @db.VarChar(64)
  companyId           String
  branchId            String
  executiveId         String

  consignorName       String      @db.VarChar(255)
  consignorAddress    String      @db.Text
  consigneeName       String      @db.VarChar(255)
  consigneeAddress    String      @db.Text
  consigneePhone      String      @db.VarChar(15)
  originCity          String      @db.VarChar(120)
  destinationCity     String      @db.VarChar(120)
  vehicleNumber       String      @db.VarChar(32)
  goodsDescription    String      @db.Text
  noOfPackages        Int
  weightKg            Decimal     @db.Decimal(12, 2)
  declaredValue       Decimal     @db.Decimal(14, 2)
  freightAmount       Decimal     @db.Decimal(14, 2)
  paymentMode         PaymentMode
  dispatchDate        String      @db.VarChar(20)
  specialInstructions String?     @db.Text
  photos              Json        // string[] of upload URLs
  signatureUrl        String?     @db.VarChar(500)

  status              LRStatus    @default(pending)
  rejectionReason     String?     @db.Text
  pdfUrl              String?     @db.VarChar(500)
  qrCode              String      @unique @db.VarChar(64)

  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  approvedAt          DateTime?
  deliveredAt         DateTime?

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  executive User    @relation("ExecutiveLRs", fields: [executiveId], references: [id], onDelete: Restrict)

  notifications Notification[]

  @@index([companyId, status, createdAt])
  @@index([branchId])
  @@index([executiveId, createdAt])
  @@index([status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String   @db.VarChar(255)
  message   String   @db.Text
  lrId      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lr   LRRequest? @relation(fields: [lrId], references: [id], onDelete: SetNull)

  @@index([userId, read, createdAt])
}

// Per-company monotonic LR serial counter (for VLP/2026/0477 style numbers).
model LRSerial {
  companyId String  @id
  counter   Int     @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

// One-time passwords for OTP login (stored in DB so it survives restarts and works across processes).
model Otp {
  mobile    String   @id @db.VarChar(15)
  code      String   @db.VarChar(8)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Uploaded files stored as binary in MySQL. Eliminates all disk/symlink issues
// on Hostinger VPS. LONGBLOB supports up to 4 GB per file.
model Upload {
  id        String   @id @default(cuid())
  path      String   @unique @db.VarChar(500)
  data      Bytes    @db.LongBlob
  mime      String   @db.VarChar(100)
  size      Int
  ownerId   String?  @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([ownerId])
  @@index([createdAt])
}

// Per-user saved consigner/consignee addresses for the mobile address book.
model SavedAddress {
  id        String   @id @default(cuid())
  userId    String
  type      String   @db.VarChar(16) // consigner | consignee
  name      String   @db.VarChar(255)
  company   String?  @db.VarChar(255)
  address   String   @db.Text
  pincode   String?  @db.VarChar(10)
  phone     String   @db.VarChar(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Append-only audit log of impactful platform actions: super-admin company
// changes, company admin LR approvals/rejections, executive invites, etc.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @db.VarChar(64)
  actorName  String   @db.VarChar(255)
  actorRole  UserRole
  companyId  String?  @db.VarChar(64)
  action     String   @db.VarChar(64)
  target     String?  @db.VarChar(255)
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([companyId, createdAt])
  @@index([action])
}
