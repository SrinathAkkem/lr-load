# ────────────────────────────────────────────────────────────────────────────
#  Rono LR — Web / API environment variables
# ────────────────────────────────────────────────────────────────────────────
# Copy to `.env` for local development. Never commit a real `.env`.
#
# ── Local dev (docker-compose MySQL on your laptop) ──────────────────────────
#   DATABASE_URL="mysql://rono:rono_local_password@localhost:3306/rono_lr"
#
# ── Hostinger shared hosting (THIS PROJECT'S CURRENT TARGET) ─────────────────
# Database: u767592127_LRLoad
# User:     u767592127_rayudugroup
# Host:     check hPanel → Databases → "Remote MySQL" or the database details
#           card. It's usually `srvNNN.hstgr.io`. The phpMyAdmin host
#           (auth-db1387.hstgr.io) is a different cluster — DO NOT use it as
#           the MySQL hostname for the app.
# Password: from hPanel → Databases (click the eye icon to reveal)
#
#   DATABASE_URL="mysql://u767592127_rayudugroup:YOUR_PASSWORD_HERE@srvNNN.hstgr.io:3306/u767592127_LRLoad"
#
# When the Node app is hosted on the same Hostinger plan, you can usually use
# `localhost` as the host instead and skip the Remote MySQL step:
#   DATABASE_URL="mysql://u767592127_rayudugroup:YOUR_PASSWORD_HERE@localhost:3306/u767592127_LRLoad"
#
# ── Hostinger VPS ────────────────────────────────────────────────────────────
#   DATABASE_URL="mysql://USER:PASS@127.0.0.1:3306/rono_lr"
#
# ── AWS RDS (MySQL 8) ────────────────────────────────────────────────────────
#   DATABASE_URL="mysql://USER:PASS@<rds-endpoint>:3306/rono_lr?sslaccept=strict"

DATABASE_URL="mysql://rono:rono_local_password@localhost:3306/rono_lr"

# Public URL the website is reachable at (used in QR links, PDF footers, etc.).
# For the temporary Hostinger preview:
#   NEXT_PUBLIC_APP_URL="https://lightblue-partridge-337209.hostingersite.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Set to `production` on the deployed server.
NODE_ENV="development"
