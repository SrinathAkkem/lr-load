# ────────────────────────────────────────────────────────────────────────────
#  Rono LR — environment variables (Hostinger VPS / local dev)
# ────────────────────────────────────────────────────────────────────────────
# Copy to `.env` for local development. On VPS, copy to `/opt/rono/lr-load/.env`.

# ── Local dev (docker-compose MySQL) ─────────────────────────────────────────
DATABASE_URL="mysql://rono:rono_local_password@localhost:3306/rono_lr"

# ── Hostinger VPS (MySQL on same server) ─────────────────────────────────────
# DATABASE_URL="mysql://rono:YOUR_DB_PASSWORD@127.0.0.1:3306/rono_lr"

# Public URL (QR links, PDF footers, mobile app API base)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# NEXT_PUBLIC_APP_URL="https://lr.yourdomain.com"

# Auth signing key — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-in-production"

# development = OTP 123456 logged locally; production = real SMS required
APP_ENV="development"
NODE_ENV="development"

# Set to true once DLT template is registered in SMSLogin
OTP_SMS_ENABLED="false"

# ━━━ SMSLogin.co (primary — India DLT) ━━━━━━━━━━━━━━━━━━━━━
SMSLOGIN_USERNAME=""
SMSLOGIN_API_KEY=""
SMSLOGIN_SENDER_ID="RONOLR"
SMSLOGIN_DLT_ENTITY_ID=""
SMSLOGIN_DLT_TELEMARKETER_ID=""
SMSLOGIN_DLT_TEMPLATE_ID=""
# Must match your DLT-approved template exactly. Use {code} for the OTP.
# SMSLOGIN_OTP_MESSAGE="{code} is your OTP to access RonoLR. It is valid for 2 minutes. Do not share this code with anyone,"

# Twilio SMS (alternative when APP_ENV=production)
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Razorpay (optional billing)
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
UPLOAD_DIR="/var/lib/rono/uploads"